new file mode 100644
index 0000000..4e58d97
--- /dev/null
+++ b/apps/backend/src/health.test.ts
@@ -0,0 +1,14 @@
+import { describe, it, expect } from 'vitest';
+import request from 'supertest';
+import app from './index';
+
+describe('GET /health', () => {
+  it('returns 200 with status ok and application metadata', async () => {
+    const response = await request(app).get('/health');
+    expect(response.status).toBe(200);
+    expect(response.body.status).toBe('ok');
+    expect(response.body.app).toBe('Combination');
+    expect(response.body.version).toBe('0.1.0');
+    expect(response.body.timestamp).toBeDefined();
+  });
+});
diff --git a/apps/backend/src/index.ts b/apps/backend/src/index.ts
new file mode 100644
index 0000000..cc0f979
--- /dev/null
+++ b/apps/backend/src/index.ts
@@ -0,0 +1,26 @@
+import express, { Request, Response } from 'express';
+import cors from 'cors';
+import { APP_NAME, APP_VERSION, HealthResponse } from '@combination/shared';
+
+const app = express();
+const port = process.env.BACKEND_PORT || 4000;
+
+app.use(cors());
+app.use(express.json());
+
+app.get('/health', (_req: Request, res: Response<HealthResponse>) => {
+  res.status(200).json({
+    status: 'ok',
+    app: APP_NAME,
+    version: APP_VERSION,
+    timestamp: new Date().toISOString()
+  });
+});
+
+if (process.env.NODE_ENV !== 'test') {
+  app.listen(port, () => {
+    console.log(`[backend] Health service listening on port ${port}`);
+  });
+}
+
+export default app;
