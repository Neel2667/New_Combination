{
  "name": "combination",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"backend,frontend\" -c \"yellow.bold,cyan.bold\" \"npm run dev -w @combination/backend\" \"npm run dev -w @combination/frontend\"",
    "dev:backend": "npm run dev -w @combination/backend",
    "dev:frontend": "npm run dev -w @combination/frontend",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.11.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.4.0"
  },
  "dependencies": {
    "multer": "^2.3.0"
  }
}
